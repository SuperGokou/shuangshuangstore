JUNANEX_EMAIL=your-email@example.com
JUNANEX_PASSWORD=your-password

# Also supported for local use:
# line 1: your email
# line 2: your password
#
# First run needs manual CAPTCHA in the opened browser.
# After .junanex/session.json is saved, set this to true if you want silent runs.
JUNANEX_HEADLESS=false
JUNANEX_SESSION_PATH=.junanex/session.json
JUNANEX_OUTPUT_PATH=data/junanex-orders.json
JUNANEX_MAX_PAGES=10
JUNANEX_MAX_ORDER_DETAIL_PAGES=200
JUNANEX_MAX_TRACKING_PAGES=120
JUNANEX_LOGIN_TIMEOUT_SECONDS=600
JUNANEX_SLOW_MO_MS=0
